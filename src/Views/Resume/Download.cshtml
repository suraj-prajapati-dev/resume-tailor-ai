@{
    ViewData["Title"] = "Download";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-main">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Download Documents</h2>
            <a href="/" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>

        <div class="text-center py-5">
            <h3 class="mb-4">Your documents are ready</h3>
            <p class="text-muted mb-4">Download your tailored documents. Files are temporary and will be deleted after session expiry.</p>
            
            <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                <a href="/api/documents/resume" class="btn btn-primary btn-lg px-4">
                    Download Resume (.docx)
                </a>
                <a href="/api/documents/cover-letter" class="btn btn-outline-primary btn-lg px-4">
                    Download Cover Letter (.docx)
                </a>
            </div>
            
            <div class="mt-4">
                <a href="/session/logout" class="btn btn-outline-secondary">
                    Start New Session
                </a>
            </div>
        </div>
    </div>
</div>
