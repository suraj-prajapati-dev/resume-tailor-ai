@{
    ViewData["Title"] = "Resume";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-main">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Resume</h2>
            <a href="/" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Uploaded Resume</h5>
            </div>
            <div class="card-body">
                <p class="text-muted" id="resume-status-detail">No resume uploaded</p>
                <div id="resume-text-container" style="display:none; max-height: 400px; overflow-y: auto;">
                    <pre id="resume-text" class="bg-light p-3 rounded"></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app.js"></script>
}
