@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-app">
    <header class="app-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center py-3">
                <h1 class="h3 mb-0">ResumeTailor-AI</h1>
                <span class="badge bg-secondary">AI-Powered Resume Tailoring</span>
            </div>
            <p class="text-muted">Tailor your resume to the job description using AI assistance.</p>
        </div>
    </header>

    <main class="app-main">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 mx-auto">
                    <div id="app-content">
                        <div class="text-center py-5" id="home-view">
                            <h2 class="mb-4">Tailor your resume to the job description.</h2>
                            <div class="mb-4">
                                <button type="button" class="btn btn-outline-primary btn-lg px-4 py-2" id="btn-upload-resume">
                                    Upload Resume
                                </button>
                            </div>
                            <div class="mb-4">
                                <button type="button" class="btn btn-outline-primary btn-lg px-4 py-2" id="btn-upload-jd">
                                    Upload Job Description
                                </button>
                            </div>
                            <div class="mb-4">
                                <input type="text" class="form-control form-control-lg text-center" 
                                       id="target-role" placeholder="Enter Target Role">
                            </div>
                            <button type="button" class="btn btn-primary btn-lg px-5 py-2" id="btn-analyze" disabled>
                                Analyze Resume
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card position-sticky" style="top: 20px;">
                        <div class="card-header">
                            <h5 class="mb-0">Session Info</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-2">Status: <span id="session-status" class="text-warning">Not Started</span></p>
                            <p class="text-muted small mb-0">Resume: <span id="resume-status">Not uploaded</span></p>
                            <p class="text-muted small">JD: <span id="jd-status">Not uploaded</span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@* Upload Modal *@
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="upload-modal-title">Upload File</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="upload-form">
                    <input type="hidden" id="upload-type">
                    <div class="mb-3">
                        <label for="file-input" class="form-label">Select File</label>
                        <input class="form-control" type="file" id="file-input" accept=".pdf,.docx,.md,.txt">
                        <div class="form-text">Supported formats: PDF, DOCX, Markdown, TXT (max 10MB)</div>
                    </div>
                </form>
                <div id="upload-progress" class="d-none">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
                <div id="upload-error" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btn-upload-file">Upload</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/app.js"></script>
    <script src="~/js/upload.js"></script>
    <script src="~/js/analysis.js"></script>
    <script src="~/js/approval.js"></script>
}
