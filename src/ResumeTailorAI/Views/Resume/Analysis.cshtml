@{
    ViewData["Title"] = "Analysis";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="app-main">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Resume Analysis</h2>
            <a href="/" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Analysis Progress</h5>
                    </div>
                    <div class="card-body">
                        <div id="progress-container">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2 text-muted">Analysis in progress...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card position-sticky" style="top: 20px;">
                    <div class="card-header">
                        <h5 class="mb-0">Session Info</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-2">Status: <span id="session-status" class="text-info">Analyzing...</span></p>
                        <p class="text-muted small mb-0">Target Role: <span id="target-role-display">-</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/analysis.js"></script>
}
